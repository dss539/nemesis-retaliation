{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dss539.github.io/nemesis-retaliation/schema/stage1-packet-completeness-review-v1.json",
  "title": "Stage 1 packet completeness review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "reviewId",
    "sealedAtUtc",
    "sealedAtGitHead",
    "packetPath",
    "packetSha256",
    "reviewer",
    "findings",
    "accepted",
    "unresolvedMaterialFindingIds"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "stage-1-packet-completeness-review"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "sealedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "sealedAtGitHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "packetPath": {
      "type": "string",
      "minLength": 1
    },
    "packetSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "$ref": "#/$defs/reviewer"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "findingId",
          "severity",
          "claim",
          "evidenceRefs",
          "disposition",
          "dispositionReason"
        ],
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "minor",
              "material",
              "critical"
            ]
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "disposition": {
            "enum": [
              "corrected",
              "rejected",
              "unresolved"
            ]
          },
          "dispositionReason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "accepted": {
      "type": "boolean"
    },
    "unresolvedMaterialFindingIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "accepted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "unresolvedMaterialFindingIds": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reviewerId",
        "provider",
        "requestedModel",
        "responseModel",
        "requestedReasoning",
        "requestMode",
        "promptPath",
        "promptSha256",
        "responsePath",
        "responseSha256",
        "thinkingRetained"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "model-assisted",
            "human"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "requestedModel": {
          "type": "string",
          "minLength": 1
        },
        "responseModel": {
          "type": "string",
          "minLength": 1
        },
        "requestedReasoning": {
          "type": "string"
        },
        "requestMode": {
          "type": "string"
        },
        "promptPath": {
          "type": "string",
          "minLength": 1
        },
        "promptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "responsePath": {
          "type": "string",
          "minLength": 1
        },
        "responseSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "thinkingRetained": {
          "const": false
        },
        "reviewerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        }
      }
    }
  }
}
