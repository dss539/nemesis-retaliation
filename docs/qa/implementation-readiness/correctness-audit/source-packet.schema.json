{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dss539.github.io/nemesis-retaliation/schema/stage1-source-packet-v1.json",
  "title": "Stage 1 source-only audit packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "packetId",
    "sealedAtUtc",
    "sealedAtGitHead",
    "auditUnitIds",
    "scope",
    "authorityOrder",
    "sourceDocuments",
    "evidence",
    "searchCoverage",
    "sourceOnlyAttestation",
    "forbiddenDownstreamSourcesIncluded"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordType": {"const": "stage-1-source-only-audit-packet"},
    "packetId": {"type": "string", "minLength": 1},
    "sealedAtUtc": {"type": "string", "format": "date-time"},
    "sealedAtGitHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "auditUnitIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scope": {"const": "base-competitive-stage1"},
    "authorityOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["official-faq-v1.2", "official-rulebook", "official-help-sheet", "official-component", "licensed-reference", "extracted-component-reference"]}
    },
    "sourceDocuments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourcePath", "sourceSha256", "authority", "version", "role"],
        "properties": {
          "sourcePath": {"type": "string", "minLength": 1},
          "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "authority": {"enum": ["official-faq-v1.2", "official-rulebook", "official-help-sheet", "official-component", "licensed-reference", "extracted-component-reference"]},
          "version": {"type": "string", "minLength": 1},
          "role": {"enum": ["official-override", "primary-rule-text", "help-sheet-text", "component-text", "visual-source", "locator-only", "negative-control-search"]}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "auditUnitIds", "sourcePath", "sourceSha256", "locator", "evidenceKind", "exactText", "visualEvidencePath", "visualEvidenceSha256", "pdfPageIndex", "renderDpi"],
        "properties": {
          "evidenceId": {"type": "string", "minLength": 1},
          "auditUnitIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "sourcePath": {"type": "string", "minLength": 1},
          "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "locator": {"type": "string", "minLength": 1},
          "evidenceKind": {"enum": ["official-text", "official-rendered-visual", "component-face", "component-source-bound-transcription", "source-scope-metadata"]},
          "exactText": {"type": ["string", "null"]},
          "visualEvidencePath": {"type": ["string", "null"]},
          "visualEvidenceSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "pdfPageIndex": {"type": ["integer", "null"], "minimum": 1},
          "renderDpi": {"type": ["integer", "null"], "minimum": 72, "maximum": 600}
        },
        "allOf": [
          {
            "if": {"properties": {"visualEvidencePath": {"type": "string"}}},
            "then": {"properties": {"visualEvidenceSha256": {"type": "string"}}},
            "else": {"properties": {"visualEvidenceSha256": {"type": "null"}}}
          }
        ],
        "anyOf": [
          {"properties": {"exactText": {"type": "string", "minLength": 1}}, "required": ["exactText"]},
          {"properties": {"visualEvidencePath": {"type": "string", "minLength": 1}}, "required": ["visualEvidencePath"]}
        ]
      }
    },
    "searchCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["searchedSourcePaths", "searchTerms", "neighboringSectionsChecked", "faqUnitIdsChecked", "componentChannelsChecked", "exclusions"],
      "properties": {
        "searchedSourcePaths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sourcePath", "sourceSha256"],
            "properties": {
              "sourcePath": {"type": "string", "minLength": 1},
              "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "searchTerms": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "neighboringSectionsChecked": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "faqUnitIdsChecked": {"type": "array", "items": {"type": "string"}},
        "componentChannelsChecked": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "exclusions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope", "reason"],
            "properties": {
              "scope": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "sourceOnlyAttestation": {"const": true},
    "forbiddenDownstreamSourcesIncluded": {"type": "array", "maxItems": 0}
  }
}
