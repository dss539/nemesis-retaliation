{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audit-result.schema.json",
  "title": "Stage 1 final audit adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "auditUnitId",
    "sealedAtUtc",
    "sealedAtGitHead",
    "family",
    "status",
    "comparisonRef",
    "verificationReviews",
    "resolution"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "stage-1-audit-adjudication"
    },
    "auditUnitId": {
      "type": "string",
      "minLength": 1
    },
    "sealedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "sealedAtGitHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "accepted",
        "material-error",
        "critical-error",
        "source-blocked"
      ]
    },
    "comparisonRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "auditUnitId"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "auditUnitId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verificationReviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verification"
      },
      "uniqueItems": true
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "repairPaths",
        "verificationEvidenceRefs",
        "notes"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-required",
            "pending",
            "source-blocked"
          ]
        },
        "repairPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verificationEvidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "not-required"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "repairPaths": {
                "maxItems": 0
              },
              "verificationEvidenceRefs": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "source-blocked"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "repairPaths": {
                "maxItems": 0
              },
              "verificationEvidenceRefs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reviewerId",
        "provider",
        "requestedModel",
        "responseModel",
        "requestedReasoning",
        "requestMode",
        "promptPath",
        "promptSha256",
        "responsePath",
        "responseSha256",
        "thinkingRetained"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "model-assisted",
            "human"
          ]
        },
        "provider": {
          "type": "string"
        },
        "requestedModel": {
          "type": "string"
        },
        "responseModel": {
          "type": "string"
        },
        "requestedReasoning": {
          "type": "string"
        },
        "requestMode": {
          "type": "string"
        },
        "promptPath": {
          "type": "string",
          "minLength": 1
        },
        "promptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "responsePath": {
          "type": "string",
          "minLength": 1
        },
        "responseSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "thinkingRetained": {
          "const": false
        },
        "reviewerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewId",
        "reviewer",
        "reviewedDiscrepancyIds",
        "sourceChecked",
        "finding",
        "disposition",
        "evidenceRefs"
      ],
      "properties": {
        "reviewId": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "$ref": "#/$defs/reviewer"
        },
        "reviewedDiscrepancyIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "sourceChecked": {
          "const": true
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "enum": [
            "confirmed",
            "not-confirmed",
            "source-blocked"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
