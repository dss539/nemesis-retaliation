{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dss539.github.io/nemesis-retaliation/schema/stage1-blind-derivation-v1.json",
  "title": "Stage 1 sealed blind derivation batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "derivationId",
    "sealedAtUtc",
    "sealedAtGitHead",
    "packetPath",
    "packetSha256",
    "completenessReviewPath",
    "completenessReviewSha256",
    "promptPath",
    "promptSha256",
    "reviewer",
    "unitResults"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "recordType": {
      "const": "stage-1-sealed-blind-derivation"
    },
    "derivationId": {
      "type": "string",
      "minLength": 1
    },
    "sealedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "sealedAtGitHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "packetPath": {
      "type": "string",
      "minLength": 1
    },
    "packetSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "completenessReviewPath": {
      "type": "string",
      "minLength": 1
    },
    "completenessReviewSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "promptPath": {
      "type": "string",
      "minLength": 1
    },
    "promptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewer": {
      "$ref": "#/$defs/reviewer"
    },
    "unitResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "auditUnitId",
          "derivationStatus",
          "blocker",
          "requirements",
          "ambiguities",
          "acceptanceScenarios",
          "unsafeAssumptions"
        ],
        "properties": {
          "auditUnitId": {
            "type": "string",
            "minLength": 1
          },
          "derivationStatus": {
            "enum": [
              "derived",
              "source-blocked"
            ]
          },
          "blocker": {
            "type": [
              "string",
              "null"
            ]
          },
          "requirements": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/requirement"
            }
          },
          "ambiguities": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/ambiguity"
            }
          },
          "acceptanceScenarios": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/scenario"
            }
          },
          "unsafeAssumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "derivationStatus": {
                  "const": "derived"
                }
              }
            },
            "then": {
              "properties": {
                "requirements": {
                  "minItems": 1
                },
                "acceptanceScenarios": {
                  "minItems": 1
                },
                "blocker": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "blocker": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reviewerId",
        "provider",
        "requestedModel",
        "responseModel",
        "requestedReasoning",
        "requestMode",
        "promptPath",
        "promptSha256",
        "responsePath",
        "responseSha256",
        "thinkingRetained"
      ],
      "properties": {
        "kind": {
          "enum": [
            "agent",
            "model-assisted",
            "human"
          ]
        },
        "provider": {
          "type": "string"
        },
        "requestedModel": {
          "type": "string"
        },
        "responseModel": {
          "type": "string"
        },
        "requestedReasoning": {
          "type": "string"
        },
        "requestMode": {
          "type": "string"
        },
        "promptPath": {
          "type": "string",
          "minLength": 1
        },
        "promptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "responsePath": {
          "type": "string",
          "minLength": 1
        },
        "responseSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "thinkingRetained": {
          "const": false
        },
        "reviewerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourcePath",
        "locator"
      ],
      "properties": {
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirementId",
        "modality",
        "behavior",
        "triggerTiming",
        "actorDecisionOwner",
        "targetCardinalityDecline",
        "visibility",
        "costsAndPayment",
        "orderedOperations",
        "finiteSupply",
        "impossibleInstructions",
        "partialResolution",
        "citations",
        "uncertainties"
      ],
      "properties": {
        "requirementId": {
          "type": "string",
          "minLength": 1
        },
        "modality": {
          "enum": [
            "must",
            "may",
            "cannot",
            "if-able",
            "mixed"
          ]
        },
        "behavior": {
          "type": "string",
          "minLength": 1
        },
        "triggerTiming": {
          "type": "string",
          "minLength": 1
        },
        "actorDecisionOwner": {
          "type": "string",
          "minLength": 1
        },
        "targetCardinalityDecline": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "minLength": 1
        },
        "costsAndPayment": {
          "type": "string",
          "minLength": 1
        },
        "orderedOperations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "finiteSupply": {
          "type": "string",
          "minLength": 1
        },
        "impossibleInstructions": {
          "type": "string",
          "minLength": 1
        },
        "partialResolution": {
          "type": "string",
          "minLength": 1
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "uncertainties": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ambiguityId",
        "question",
        "alternatives",
        "defaultProhibited",
        "citations"
      ],
      "properties": {
        "ambiguityId": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string"
          }
        },
        "defaultProhibited": {
          "const": true
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "given",
        "when",
        "then",
        "citations"
      ],
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "given": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "type": "string",
          "minLength": 1
        },
        "then": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/citation"
          }
        }
      }
    }
  }
}
